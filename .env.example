# ============================================
# Nishma Wellness - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# All services below have FREE tiers

# ============================================
# DATABASE (Required)
# ============================================
# Local development (Postgres on your machine)
# Update user/password/db name to match your local Postgres setup
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nishma"

# ============================================
# AUTH (Required)
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secret-key-with-openssl-rand"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional - free unlimited)
# Sign up: https://console.cloud.google.com
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ============================================
# AI / LLM (For real AI responses)
# ============================================
# Anthropic Claude API (free $5 credit on signup).
# When set, AI chat uses Claude Haiku 4.5. When unset, falls back
# to the built-in rule-based responder (still works for demo).
# Sign up: https://console.anthropic.com
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"  # optional, defaults to Haiku 4.5

# OpenAI alternative (not currently wired)
# OPENAI_API_KEY=""

# ============================================
# PAYMENTS (Stripe)
# ============================================
# Free test mode - unlimited transactions
# Sign up: https://stripe.com
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# EMAIL (Resend)
# ============================================
# Free: 100 emails/day, 3000/month. When unset, emails are
# logged to the server console (safe dev/pilot fallback).
# Sign up: https://resend.com
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Nishma Wellness <onboarding@resend.dev>"  # optional override
# SALES_NOTIFICATION_EMAIL="sales@nishmawellness.com"  # demo requests CC'd here

# ============================================
# VIDEO CALLS (Jitsi Meet — meet.jit.si public instance)
# ============================================
# No API key required. Embedded via Jitsi External API in
# /video-session/[id]. Self-host or upgrade to 8x8.vc later
# for moderator tokens / HIPAA-eligible deployment.

# ============================================
# AI VOICE / TTS (ElevenLabs)
# ============================================
# Free: 10,000 characters/month
# Sign up: https://elevenlabs.io
# ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID=""

# ============================================
# AI VIDEO AVATAR (D-ID)
# ============================================
# Free: 5 minutes trial
# Sign up: https://d-id.com
# DID_API_KEY=""

# ============================================
# FILE STORAGE (Cloudinary)
# ============================================
# Free: 25GB storage, 25GB bandwidth
# Sign up: https://cloudinary.com
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ============================================
# CRON JOBS
# ============================================
# Used to authenticate scheduled invocations of /api/cron/*
# (e.g. 24-hour appointment reminders). Generate with:
#   openssl rand -hex 32
# Vercel Cron will automatically include this header when set.
# CRON_SECRET=""

# ============================================
# DEPLOYMENT
# ============================================
# Vercel (free: 100GB bandwidth)
# Sign up: https://vercel.com
# No env vars needed - configured in Vercel dashboard
