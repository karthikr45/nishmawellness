generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  name           String
  role           String    @default("PATIENT") // PATIENT, THERAPIST, ADMIN
  phone          String?
  avatar         String?
  bio            String?
  specialization String?   // For therapists
  licenseNumber  String?   // For therapists
  experience     Int?      // Years of experience for therapists
  hourlyRate     Float?    // For therapists
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizationId    String?  // If user belongs to a corporate org
  lastLoginAt       DateTime? // Track last login for return experience
  onboardingDone    Boolean  @default(false)  // Has completed onboarding questionnaire
  familyId          String?  // Family group ID
  familyRole        String?  // PRIMARY, SPOUSE, CHILD, PARENT, SIBLING

  // Relations
  patientAppointments   Appointment[]   @relation("PatientAppointments")
  therapistAppointments Appointment[]   @relation("TherapistAppointments")
  enrollments           Enrollment[]
  sentMessages          Message[]       @relation("SentMessages")
  receivedMessages      Message[]       @relation("ReceivedMessages")
  aiChats               AIChat[]
  sessionNotes          SessionNote[]
  availability          Availability[]
  progressRecords       Progress[]
  reviews               Review[]        @relation("PatientReviews")
  therapistReviews      Review[]        @relation("TherapistReviews")
  notifications         Notification[]
  patientContexts       PatientContext[] @relation("PatientContexts")
  therapistContexts     PatientContext[] @relation("TherapistContexts")
  aiMemories            AIMemory[]
  userActivities        UserActivity[]
  therapistContinuity   ContinuityScore[] @relation("TherapistContinuity")
  patientContinuity     ContinuityScore[] @relation("PatientContinuity")
  orgMemberships        OrgMember[]
  journalEntries        JournalEntry[]
  assessments           Assessment[]
  lessonProgress        LessonProgress[]
  exerciseLogs          ExerciseLog[]
  groupSessionMembers   GroupSessionMember[]
  hostedGroupSessions   GroupSession[]   @relation("HostedGroupSessions")
  onboardingResponse    OnboardingResponse?
  familyGroup           FamilyGroup?     @relation("FamilyOwner")
  familyMemberships     FamilyMember[]
  twinCloneProfile      TwinCloneProfile? @relation("TwinCloneOwner")
  handoffsAsTherapist   SessionHandoff[]  @relation("HandoffTherapist")
  handoffsAsPatient     SessionHandoff[]  @relation("HandoffPatient")
  aiConsent             AIConsent?
  auditLogs             AuditLog[]
  moderationFlags       ModerationFlag[]
  campusMemberships     CampusMember[]
  region                String?   @default("US") // US, IN, etc.
  userType              String?   // INDIVIDUAL, STUDENT, EMPLOYEE

  // Couples
  partnershipAsPartnerA  CouplePartnership? @relation("PartnerA")
  partnershipAsPartnerB  CouplePartnership? @relation("PartnerB")
  coupleCheckins         CoupleCheckin[]
  coupleJournals         CoupleJournal[]

  // Locality
  localityMemberships    LocalityMember[]
  localityPosts          LocalityPost[]
  localityEvents         LocalityEvent[] @relation("EventHost")
  localityRsvps          LocalityEventRsvp[]

  // Community forum
  forumPosts             ForumPost[]

  // Family wellness (kids, habits, goals, gratitude)
  childProfiles          ChildProfile[]
  childMoodLogs          ChildMoodLog[]    @relation("MoodLogger")
  childFoodLogs          ChildFoodLog[]    @relation("FoodLogger")
  familyHabitLogs        FamilyHabitLog[]
  familyGratitudes       FamilyGratitude[] @relation("GratitudeFrom")
  familyGratitudesReceived FamilyGratitude[] @relation("GratitudeTo")
}

model Appointment {
  id             String    @id @default(uuid())
  patientId      String
  therapistId    String
  dateTime       DateTime
  duration       Int       @default(60) // minutes
  type           String    @default("VIDEO") // VIDEO, IN_PERSON, AI_SESSION
  status         String    @default("SCHEDULED") // SCHEDULED, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED
  notes          String?
  meetingUrl     String?
  reminderSentAt DateTime? // 24-hr reminder timestamp; null = not yet sent
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient     User     @relation("PatientAppointments", fields: [patientId], references: [id])
  therapist   User     @relation("TherapistAppointments", fields: [therapistId], references: [id])
  sessionNote SessionNote?
  review      Review?
}

model Program {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String   // YOGA, MEDITATION, FITNESS, NUTRITION, MENTAL_HEALTH, STRESS_MANAGEMENT
  duration    String   // e.g., "8 weeks"
  level       String   // BEGINNER, INTERMEDIATE, ADVANCED
  price       Float
  image       String?
  modules     String   // JSON string of modules
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  orgPrograms OrgProgram[]
  lessons     Lesson[]
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  programId  String
  progress   Float    @default(0) // percentage 0-100
  status     String   @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  startedAt  DateTime @default(now())
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id])
  program Program @relation(fields: [programId], references: [id])

  @@unique([userId, programId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model AIChat {
  id           String   @id @default(uuid())
  userId       String
  role         String   // "user" or "assistant"
  content      String
  sessionId    String   // Groups messages in a conversation
  therapistId  String?  // Which therapist's clone was used (null = generic AI)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SessionNote {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  therapistId   String
  content       String
  mood          String?  // Patient mood assessment
  progress      String?
  homework      String?  // Assigned homework/exercises
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  therapist   User        @relation(fields: [therapistId], references: [id])
}

model Availability {
  id          String @id @default(uuid())
  therapistId String
  dayOfWeek   Int    // 0=Sunday, 6=Saturday
  startTime   String // "09:00"
  endTime     String // "17:00"
  isAvailable Boolean @default(true)

  therapist User @relation(fields: [therapistId], references: [id])
}

model Progress {
  id        String   @id @default(uuid())
  userId    String
  type      String   // MOOD, SLEEP, EXERCISE, NUTRITION, MINDFULNESS
  value     Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  patientId     String
  therapistId   String
  rating        Int      // 1-5
  comment       String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patient     User        @relation("PatientReviews", fields: [patientId], references: [id])
  therapist   User        @relation("TherapistReviews", fields: [therapistId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // APPOINTMENT, MESSAGE, PROGRAM, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ============================================
// FEATURE: Digital TwinClone System
// ============================================

model TwinCloneProfile {
  id              String   @id @default(uuid())
  therapistId     String   @unique
  isActive        Boolean  @default(true)
  personality     String   @default("empathetic") // empathetic, professional, casual, motivational
  approach        String   @default("")  // CBT, Mindfulness, Holistic, etc.
  tone            String   @default("warm") // warm, professional, casual
  greeting        String   @default("")  // Custom greeting message
  focusAreas      String   @default("[]") // JSON array
  boundaries      String   @default("")  // Safety boundaries
  sampleResponses String   @default("[]") // JSON array of {question, answer} pairs
  knowledgeBase   String   @default("[]") // JSON array of {topic, content} entries
  techniques      String   @default("[]") // JSON array of therapeutic techniques
  phrases         String   @default("[]") // JSON array of signature phrases
  voiceStyle      String   @default("calm") // calm, energetic, soothing
  avatarStyle     String   @default("default") // avatar appearance preset
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  therapist       User     @relation("TwinCloneOwner", fields: [therapistId], references: [id])
  reviews         TwinCloneReview[]
}

// Therapist reviews AI clone conversations
model TwinCloneReview {
  id              String   @id @default(uuid())
  twinCloneId     String
  sessionId       String   // AI chat session ID
  therapistId     String
  patientId       String
  status          String   @default("PENDING") // PENDING, REVIEWED, FLAGGED
  feedback        String?  // Therapist feedback on AI responses
  accuracy        Int?     // 1-5 rating of how accurate the clone was
  corrections     String   @default("[]") // JSON array of corrections
  createdAt       DateTime @default(now())

  twinClone       TwinCloneProfile @relation(fields: [twinCloneId], references: [id])
}

// Handoff summary: AI prepares brief for therapist before real session
model SessionHandoff {
  id              String   @id @default(uuid())
  therapistId     String
  patientId       String
  appointmentId   String?  // Linked upcoming appointment
  aiSummary       String   // AI-generated summary of recent chats
  keyTopics       String   @default("[]") // JSON array
  moodTrend       String?  // improving, stable, declining
  riskFlags       String   @default("[]") // JSON array of concerns
  suggestedFocus  String   @default("[]") // JSON array of suggested session topics
  chatCount       Int      @default(0)    // Number of AI chats since last session
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  therapist       User     @relation("HandoffTherapist", fields: [therapistId], references: [id])
  patient         User     @relation("HandoffPatient", fields: [patientId], references: [id])
}

// ============================================
// FEATURE: Onboarding Questionnaire
// ============================================

model OnboardingResponse {
  id              String   @id @default(uuid())
  userId          String   @unique
  responses       String   // JSON: all answers
  primaryGoals    String   @default("[]") // JSON array
  stressLevel     Int?     // 1-10
  sleepQuality    Int?     // 1-10
  exerciseFreq    String?  // NEVER, RARELY, WEEKLY, DAILY
  therapyHistory  String?  // NEVER, PAST, CURRENT
  preferredStyle  String?  // CBT, MINDFULNESS, HOLISTIC, TALK_THERAPY, UNSURE
  concerns        String   @default("[]") // JSON array of presenting concerns
  emergencyContact String? // JSON { name, phone, relationship }
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ============================================
// FEATURE: Family Wellness Module
// ============================================

model FamilyGroup {
  id          String   @id @default(uuid())
  name        String   // e.g. "The Thompson Family"
  ownerId     String   @unique
  plan        String   @default("FAMILY_BASIC") // FAMILY_BASIC, FAMILY_PLUS, FAMILY_PREMIUM
  maxMembers  Int      @default(5)
  sharedGoals String   @default("[]") // JSON array of shared family goals
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User           @relation("FamilyOwner", fields: [ownerId], references: [id])
  members FamilyMember[]
}

model FamilyMember {
  id            String   @id @default(uuid())
  familyGroupId String
  userId        String
  role          String   @default("MEMBER") // PRIMARY, SPOUSE, CHILD, PARENT, SIBLING, MEMBER
  canViewProgress Boolean @default(false) // Can see shared wellness metrics
  isMinor       Boolean  @default(false)
  joinedAt      DateTime @default(now())

  familyGroup FamilyGroup @relation(fields: [familyGroupId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([familyGroupId, userId])
}

// ============================================
// FEATURE: Lesson Content System
// ============================================

model Lesson {
  id          String   @id @default(uuid())
  programId   String
  title       String
  description String   @default("")
  order       Int      @default(0)
  type        String   @default("VIDEO") // VIDEO, AUDIO, TEXT, EXERCISE, QUIZ
  content     String   @default("{}") // JSON: varies by type
  duration    Int      @default(15) // minutes
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program  Program          @relation(fields: [programId], references: [id])
  progress LessonProgress[]
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  status      String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  timeSpent   Int       @default(0) // seconds
  quizScore   Float?    // For quiz lessons
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

// ============================================
// FEATURE: Wellness Assessments (PHQ-9, GAD-7)
// ============================================

model Assessment {
  id          String   @id @default(uuid())
  userId      String
  type        String   // PHQ9, GAD7, PSS, WHODAS, CUSTOM
  responses   String   // JSON array of answers
  score       Int
  severity    String   // MINIMAL, MILD, MODERATE, MODERATELY_SEVERE, SEVERE
  notes       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ============================================
// FEATURE: Daily Check-in Journal
// ============================================

model JournalEntry {
  id          String   @id @default(uuid())
  userId      String
  mood        Int      // 1-10
  energy      Int      // 1-10
  anxiety     Int      // 1-10
  sleep       Int      // 1-10 quality
  gratitude   String   @default("") // What are you grateful for
  highlight   String   @default("") // Best part of the day
  challenge   String   @default("") // Biggest challenge
  freeWrite   String   @default("") // Open journaling
  tags        String   @default("[]") // JSON array of tags
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ============================================
// FEATURE: Guided Exercises (Meditation, Breathing)
// ============================================

model GuidedExercise {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String   // BREATHING, MEDITATION, BODY_SCAN, VISUALIZATION, GROUNDING, PMR
  duration    Int      // seconds
  steps       String   // JSON array of steps with timing
  difficulty  String   @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  logs ExerciseLog[]
}

model ExerciseLog {
  id          String   @id @default(uuid())
  userId      String
  exerciseId  String
  completed   Boolean  @default(false)
  duration    Int      @default(0) // actual seconds spent
  rating      Int?     // 1-5 how helpful
  createdAt   DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id])
  exercise GuidedExercise @relation(fields: [exerciseId], references: [id])
}

// ============================================
// FEATURE: Group Therapy Sessions / Workshops
// ============================================

model GroupSession {
  id           String   @id @default(uuid())
  title        String
  description  String
  hostId       String   // Therapist hosting
  category     String   // SUPPORT_GROUP, WORKSHOP, WEBINAR, MEDITATION_CIRCLE
  dateTime     DateTime
  duration     Int      @default(60) // minutes
  maxParticipants Int   @default(20)
  price        Float    @default(0) // 0 = free
  isRecurring  Boolean  @default(false)
  recurrence   String?  // WEEKLY, BIWEEKLY, MONTHLY
  meetingUrl   String?
  status       String   @default("SCHEDULED") // SCHEDULED, LIVE, COMPLETED, CANCELLED
  tags         String   @default("[]") // JSON array
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  host    User                 @relation("HostedGroupSessions", fields: [hostId], references: [id])
  members GroupSessionMember[]
}

model GroupSessionMember {
  id             String   @id @default(uuid())
  groupSessionId String
  userId         String
  status         String   @default("REGISTERED") // REGISTERED, ATTENDED, NO_SHOW, CANCELLED
  joinedAt       DateTime @default(now())

  groupSession GroupSession @relation(fields: [groupSessionId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([groupSessionId, userId])
}

// ============================================
// FEATURE: Patient Context & Memory System
// ============================================

model PatientContext {
  id            String   @id @default(uuid())
  patientId     String
  therapistId   String
  keyTopics     String   @default("[]")  // JSON array of recurring themes
  lifeEvents    String   @default("[]")  // JSON array of significant events
  copingTools   String   @default("[]")  // What works for this patient
  triggers      String   @default("[]")  // Known triggers
  preferences   String   @default("[]")  // Communication preferences
  summary       String   @default("")    // Running summary of patient journey
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())

  patient   User @relation("PatientContexts", fields: [patientId], references: [id])
  therapist User @relation("TherapistContexts", fields: [therapistId], references: [id])

  @@unique([patientId, therapistId])
}

// AI Memory - stores extracted themes from conversations
model AIMemory {
  id          String   @id @default(uuid())
  userId      String
  category    String   // TOPIC, EVENT, COMMITMENT, DETAIL, PERSON, PATTERN, MILESTONE, TRIGGER, COPING, PREFERENCE
  content     String   // The actual memory content
  context     String   @default("") // Full sentence/context when this was mentioned
  source      String   // AI_CHAT, SESSION_NOTE, SELF_REPORTED, JOURNAL
  sessionId   String?  // Which chat session this came from
  weight      Float    @default(1.0) // Importance/recency weight
  mentionCount Int     @default(1)  // How many times this has come up
  lastMentioned DateTime @default(now()) // When it was last referenced
  isResolved  Boolean  @default(false) // For commitments/goals that are completed
  linkedMemoryId String? // Link related memories together
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// User Activity tracking for personalized return experience
model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  type      String   // LOGIN, CHAT, SESSION, PROGRAM, MOOD_LOG
  metadata  String   @default("{}") // JSON with context
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Therapist Continuity Score
model ContinuityScore {
  id                String   @id @default(uuid())
  therapistId       String
  patientId         String
  score             Float    @default(0) // 0-100
  contextUsage      Float    @default(0) // How often therapist views context
  noteCompleteness  Float    @default(0) // Session note quality
  followUpRate      Float    @default(0) // References previous sessions
  patientRetention  Float    @default(0) // Patient keeps coming back
  lastCalculated    DateTime @default(now())

  therapist User @relation("TherapistContinuity", fields: [therapistId], references: [id])
  patient   User @relation("PatientContinuity", fields: [patientId], references: [id])

  @@unique([therapistId, patientId])
}

// ============================================
// FEATURE: Universal Company Module
// Works for ANY industry: Banks, Hospitals, IT, Manufacturing, Retail, Govt
// ============================================

model Organization {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  domain          String?  // Email domain for auto-matching (@acme.com)
  domains         String   @default("[]") // JSON array of allowed domains
  logo            String?
  industry        String?  // BANKING, HEALTHCARE, IT, MANUFACTURING, RETAIL, EDUCATION, GOVERNMENT, OTHER
  size            String?  // STARTUP, SMALL, MEDIUM, LARGE, ENTERPRISE
  country         String   @default("US")
  currency        String   @default("USD")
  contactEmail    String
  contactName     String
  contactPhone    String?
  plan            String   @default("STANDARD") // STARTER, STANDARD, PREMIUM, ENTERPRISE
  maxEmployees    Int      @default(100)
  sessionsPerEmployee Int  @default(12) // Per year
  isActive        Boolean  @default(true)
  features        String   @default("{}") // JSON feature flags
  joinCode        String?  @unique // Self-registration code for employees
  welcomeMessage  String?  // Custom welcome message for employees
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  locations       OrgLocation[]
  members         OrgMember[]
  programs        OrgProgram[]
  analytics       OrgAnalytics[]
  surveys         PulseSurvey[]
  challenges      WellnessChallenge[]
  feedbacks       AnonFeedback[]
  invites         OrgInvite[]
  burnoutRisks    BurnoutRisk[]    @relation("BurnoutRisks")
  incidents       CriticalIncident[] @relation("Incidents")
  recognitions    PeerRecognition[] @relation("Recognitions")
  teamScores      TeamWellnessScore[] @relation("TeamScores")
}

// Physical locations (branches, offices, plants, clinics)
model OrgLocation {
  id             String   @id @default(uuid())
  organizationId String
  name           String   // "Mumbai HQ", "Delhi Branch", "Pune Plant"
  type           String   @default("OFFICE") // OFFICE, BRANCH, PLANT, HOSPITAL, STORE, WAREHOUSE, CAMPUS
  address        String?
  city           String?
  state          String?
  country        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  divisions    OrgDivision[]
  members      OrgMember[]
}

// Divisions / Business Units within a location
model OrgDivision {
  id             String   @id @default(uuid())
  locationId     String
  name           String   // "Technology", "Operations", "Clinical", "Production"
  head           String?  // User ID of division head
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  location    OrgLocation    @relation(fields: [locationId], references: [id])
  departments OrgDepartment[]
}

// Departments within a division
model OrgDepartment {
  id          String   @id @default(uuid())
  divisionId  String
  name        String   // "Engineering", "Nursing", "Assembly", "Accounts"
  head        String?  // User ID of department head/manager
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  division OrgDivision @relation(fields: [divisionId], references: [id])
  members  OrgMember[]
}

model OrgMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  locationId     String?
  departmentId   String?
  role           String   @default("EMPLOYEE") // EMPLOYEE, MANAGER, HR_MANAGER, DEPT_HEAD, UNIT_HEAD, ORG_ADMIN
  employeeId     String?  // Company employee ID
  designation    String?  // Job title
  isAnonymous    Boolean  @default(true)
  sessionsUsed   Int      @default(0)
  sessionsAllowed Int     @default(12) // Per year
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  location     OrgLocation?     @relation(fields: [locationId], references: [id])
  department   OrgDepartment?   @relation(fields: [departmentId], references: [id])

  @@unique([organizationId, userId])
}

// Invite system for employee onboarding
model OrgInvite {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  role           String   @default("EMPLOYEE")
  locationId     String?
  departmentId   String?
  status         String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  invitedBy      String   // User ID who sent the invite
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

// Custom programs assigned to organizations
model OrgProgram {
  id             String @id @default(uuid())
  organizationId String
  programId      String

  organization Organization @relation(fields: [organizationId], references: [id])
  program      Program      @relation(fields: [programId], references: [id])

  @@unique([organizationId, programId])
}

// Aggregated anonymous analytics
model OrgAnalytics {
  id               String   @id @default(uuid())
  organizationId   String
  period           String   // "2024-03", "2024-W12"
  locationId       String?
  departmentId     String?
  totalSessions    Int      @default(0)
  uniqueUsers      Int      @default(0)
  avgMoodScore     Float?
  avgSatisfaction  Float?
  topCategories    String   @default("[]")
  engagementRate   Float    @default(0)
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

// Company-wide wellness challenges
model WellnessChallenge {
  id              String   @id @default(uuid())
  organizationId  String
  title           String
  description     String
  type            String   @default("STEPS") // STEPS, MEDITATION, JOURNAL, EXERCISE, CUSTOM
  target          Int      @default(0) // Target value (e.g., 10000 steps, 7 journal entries)
  unit            String   @default("") // "steps", "minutes", "entries"
  startDate       DateTime
  endDate         DateTime
  prize           String?  // Description of reward
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  participants    ChallengeParticipant[]
}

model ChallengeParticipant {
  id           String   @id @default(uuid())
  challengeId  String
  userId       String
  progress     Float    @default(0)
  isCompleted  Boolean  @default(false)
  joinedAt     DateTime @default(now())

  challenge WellnessChallenge @relation(fields: [challengeId], references: [id])

  @@unique([challengeId, userId])
}

// Anonymous employee feedback to HR
model AnonFeedback {
  id             String   @id @default(uuid())
  organizationId String
  category       String   // WORKPLACE_STRESS, MANAGEMENT, WORKLOAD, CULTURE, HARASSMENT, SUGGESTION, OTHER
  message        String
  severity       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status         String   @default("NEW") // NEW, ACKNOWLEDGED, IN_PROGRESS, RESOLVED
  adminNotes     String?
  locationId     String?
  departmentId   String?
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
}

// Burnout prediction scores
model BurnoutRisk {
  id              String   @id @default(uuid())
  organizationId  String
  departmentId    String?
  locationId      String?
  riskScore       Float    // 0-100
  riskLevel       String   // LOW, MODERATE, HIGH, CRITICAL
  factors         String   @default("[]") // JSON: contributing factors
  employeeCount   Int      @default(0)
  atRiskCount     Int      @default(0)
  trend           String?  // IMPROVING, STABLE, WORSENING
  calculatedAt    DateTime @default(now())

  organization Organization @relation("BurnoutRisks", fields: [organizationId], references: [id])
}

// Critical incident tracking
model CriticalIncident {
  id              String   @id @default(uuid())
  organizationId  String
  type            String   // CRISIS_DETECTED, SEVERE_ASSESSMENT, BURNOUT_ALERT, ABSENCE_PATTERN
  severity        String   // LOW, MEDIUM, HIGH, CRITICAL
  description     String
  departmentId    String?
  locationId      String?
  status          String   @default("NEW") // NEW, ACKNOWLEDGED, INTERVENING, RESOLVED, ESCALATED
  assignedTo      String?  // HR person handling this
  actionsTaken    String   @default("[]") // JSON array of actions
  isAnonymous     Boolean  @default(true)
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  organization Organization @relation("Incidents", fields: [organizationId], references: [id])
}

// Peer recognition
model PeerRecognition {
  id              String   @id @default(uuid())
  organizationId  String
  fromUserId      String
  toUserId        String
  message         String
  category        String   // SUPPORT, KINDNESS, TEAMWORK, MENTORING, POSITIVITY, RESILIENCE
  isAnonymous     Boolean  @default(true)
  likes           Int      @default(0)
  createdAt       DateTime @default(now())

  organization Organization @relation("Recognitions", fields: [organizationId], references: [id])
}

// Team leaderboard scores
model TeamWellnessScore {
  id              String   @id @default(uuid())
  organizationId  String
  departmentId    String?
  locationId      String?
  teamName        String
  score           Float    @default(0) // Composite wellness score
  participation   Float    @default(0) // % of team participating
  streak          Int      @default(0) // Consecutive active weeks
  exercisePoints  Int      @default(0)
  journalPoints   Int      @default(0)
  moodPoints      Int      @default(0)
  period          String   // "2026-W14" or "2026-03"
  calculatedAt    DateTime @default(now())

  organization Organization @relation("TeamScores", fields: [organizationId], references: [id])
}

// ============================================
// FEATURE: Campus / Student Module
// ============================================

model Campus {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  type            String   @default("UNIVERSITY") // UNIVERSITY, COLLEGE, SCHOOL, INSTITUTE
  domain          String?
  contactEmail    String
  contactName     String
  studentCount    Int      @default(0)
  plan            String   @default("CAMPUS_BASIC")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  students        CampusMember[]
  surveys         PulseSurvey[]
}

model CampusMember {
  id           String   @id @default(uuid())
  campusId     String
  userId       String
  role         String   @default("STUDENT")
  department   String?
  year         String?
  isAnonymous  Boolean  @default(true)
  joinedAt     DateTime @default(now())

  campus  Campus @relation(fields: [campusId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([campusId, userId])
}

// ============================================
// FEATURE: Pulse Surveys (HR + Campus)
// ============================================

model PulseSurvey {
  id              String   @id @default(uuid())
  title           String
  organizationId  String?
  campusId        String?
  questions       String
  isActive        Boolean  @default(true)
  frequency       String   @default("WEEKLY")
  createdAt       DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  campus       Campus?       @relation(fields: [campusId], references: [id])
  responses    PulseSurveyResponse[]
}

model PulseSurveyResponse {
  id         String   @id @default(uuid())
  surveyId   String
  userId     String
  answers    String
  anonymous  Boolean  @default(true)
  createdAt  DateTime @default(now())

  survey PulseSurvey @relation(fields: [surveyId], references: [id])
}

// ============================================
// FEATURE: Compliance & Safety
// ============================================

model AIConsent {
  id          String   @id @default(uuid())
  userId      String   @unique
  consentGiven Boolean @default(false)
  consentType String   @default("ADULT") // ADULT, MINOR_PARENT, MINOR_SELF
  version     String   @default("1.0")
  ipAddress   String?
  givenAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  sessionId     String?
  action        String   // SAFETY_REDIRECT, NORMAL, CRISIS_DETECTED, OFF_TOPIC, MEDICAL_BOUNDARY, CONSENT_GIVEN
  category      String?  // SUICIDAL_IDEATION, SELF_HARM, MEDICAL, OFF_TOPIC, etc.
  severity      String?  // LOW, MEDIUM, HIGH, CRITICAL
  messageSnippet String? // First 200 chars for context (not full message for privacy)
  metadata      String   @default("{}") // JSON additional data
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ModerationFlag {
  id            String   @id @default(uuid())
  userId        String
  sessionId     String
  reason        String   // CRISIS, SELF_HARM, ABUSE, HARMFUL_CONTENT, THERAPIST_FLAGGED
  severity      String   // LOW, MEDIUM, HIGH, CRITICAL
  messageSnippet String?
  status        String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, ESCALATED
  reviewedBy    String?  // Admin/therapist who reviewed
  reviewNotes   String?
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?

  user User @relation(fields: [userId], references: [id])
}

// ============================================
// FEATURE: Couples / Partner Wellness
// ============================================

model CouplePartnership {
  id              String   @id @default(uuid())
  partnerAId      String   @unique
  partnerBId      String   @unique
  status          String   @default("PENDING") // PENDING, ACTIVE, PAUSED, ENDED
  anniversary     DateTime?
  loveLanguageA   String?  // WORDS, ACTS, GIFTS, TIME, TOUCH
  loveLanguageB   String?
  sharedGoals     String   @default("[]") // JSON array
  communicationStyle String? // CBT_BASED, GOTTMAN, NVC, IMAGO
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partnerA        User     @relation("PartnerA", fields: [partnerAId], references: [id])
  partnerB        User     @relation("PartnerB", fields: [partnerBId], references: [id])
  checkins        CoupleCheckin[]
  journals        CoupleJournal[]
}

model CoupleCheckin {
  id              String   @id @default(uuid())
  partnershipId   String
  userId          String
  communication   Int      // 1-10
  connection      Int      // 1-10
  conflict        Int      // 1-10 (10 = no conflict)
  gratitudeNote   String?
  date            DateTime @default(now())

  partnership     CouplePartnership @relation(fields: [partnershipId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
}

model CoupleJournal {
  id              String   @id @default(uuid())
  partnershipId   String
  userId          String
  type            String   @default("SHARED") // SHARED (both see) or PRIVATE (only me)
  content         String
  tags            String   @default("[]") // JSON array
  createdAt       DateTime @default(now())

  partnership     CouplePartnership @relation(fields: [partnershipId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
}

// ============================================
// FEATURE: Locality / Neighbourhood Community
// ============================================

model Locality {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  city            String
  state           String?
  country         String   @default("IN")
  pinCode         String?
  description     String?
  coverImage      String?
  isActive        Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         LocalityMember[]
  posts           LocalityPost[]
  events          LocalityEvent[]
}

model LocalityMember {
  id              String   @id @default(uuid())
  localityId      String
  userId          String
  role            String   @default("MEMBER") // MEMBER, MODERATOR, ADMIN
  displayName     String?
  isAnonymous     Boolean  @default(true)
  joinedAt        DateTime @default(now())

  locality        Locality @relation(fields: [localityId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@unique([localityId, userId])
}

model LocalityPost {
  id              String   @id @default(uuid())
  localityId      String
  userId          String
  type            String   @default("DISCUSSION") // DISCUSSION, TIP, RESOURCE, QUESTION, SUPPORT
  title           String
  content         String
  tags            String   @default("[]") // JSON array
  likes           Int      @default(0)
  isPinned        Boolean  @default(false)
  isAnonymous     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  locality        Locality @relation(fields: [localityId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
}

model LocalityEvent {
  id              String   @id @default(uuid())
  localityId      String
  hostId          String
  title           String
  description     String
  type            String   @default("MEETUP") // MEETUP, YOGA, WALK, MEDITATION, WORKSHOP, BOOK_CLUB, SUPPORT_CIRCLE
  location        String?
  dateTime        DateTime
  duration        Int      @default(60)
  maxParticipants Int      @default(20)
  isFree          Boolean  @default(true)
  isRecurring     Boolean  @default(false)
  recurrence      String?  // WEEKLY, BIWEEKLY, MONTHLY
  status          String   @default("UPCOMING") // UPCOMING, LIVE, COMPLETED, CANCELLED
  createdAt       DateTime @default(now())

  locality        Locality @relation(fields: [localityId], references: [id])
  host            User     @relation("EventHost", fields: [hostId], references: [id])
  rsvps           LocalityEventRsvp[]
}

model LocalityEventRsvp {
  id              String   @id @default(uuid())
  eventId         String
  userId          String
  status          String   @default("GOING") // GOING, MAYBE, NOT_GOING
  joinedAt        DateTime @default(now())

  event           LocalityEvent @relation(fields: [eventId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

// ============================================
// FEATURE: Community Forum (Global)
// ============================================

model ForumPost {
  id          String   @id @default(uuid())
  userId      String
  category    String   // Anxiety, Depression, Mindfulness, Relationships, Sleep, Motivation, General
  title       String
  content     String
  tags        String   @default("[]") // JSON array
  likes       Int      @default(0)
  isAnonymous Boolean  @default(true)
  displayName String?  // Anonymous alias
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ============================================
// FEATURE: Site Configuration (Admin Settings)
// ============================================

model SiteConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================
// FEATURE: Family Wellness System
// Kids health, family habits, goals, gratitude
// ============================================

model ChildProfile {
  id            String   @id @default(uuid())
  parentId      String
  name          String
  dateOfBirth   DateTime
  gender        String?  // MALE, FEMALE, OTHER
  avatar        String?
  allergies     String   @default("[]") // JSON array
  conditions    String   @default("[]") // JSON array (asthma, ADHD, etc.)
  bloodGroup    String?
  school        String?
  grade         String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent        User           @relation(fields: [parentId], references: [id])
  growthLogs    ChildGrowthLog[]
  moodLogs      ChildMoodLog[]
  foodLogs      ChildFoodLog[]
  sleepLogs     ChildSleepLog[]
  milestones    ChildMilestone[]
  habitAssigns  FamilyHabitAssign[]
}

model ChildGrowthLog {
  id          String   @id @default(uuid())
  childId     String
  height      Float?   // cm
  weight      Float?   // kg
  headCirc    Float?   // cm (for infants)
  notes       String?
  date        DateTime @default(now())

  child       ChildProfile @relation(fields: [childId], references: [id])
}

model ChildMoodLog {
  id          String   @id @default(uuid())
  childId     String
  loggedById  String
  mood        String   // emoji: 😄 😊 😐 😢 😡 😰
  energy      Int?     // 1-5
  notes       String?
  date        DateTime @default(now())

  child       ChildProfile @relation(fields: [childId], references: [id])
  loggedBy    User         @relation("MoodLogger", fields: [loggedById], references: [id])
}

model ChildFoodLog {
  id          String   @id @default(uuid())
  childId     String
  loggedById  String
  mealType    String   // BREAKFAST, LUNCH, DINNER, SNACK
  items       String   // JSON array of food items
  waterCups   Int?     // glasses of water
  category    String?  // HEALTHY, MIXED, JUNK
  notes       String?
  date        DateTime @default(now())

  child       ChildProfile @relation(fields: [childId], references: [id])
  loggedBy    User         @relation("FoodLogger", fields: [loggedById], references: [id])
}

model ChildSleepLog {
  id          String   @id @default(uuid())
  childId     String
  bedtime     String   // "21:00"
  wakeTime    String   // "07:00"
  napMinutes  Int?     // total nap duration
  quality     Int?     // 1-5
  notes       String?
  date        DateTime @default(now())

  child       ChildProfile @relation(fields: [childId], references: [id])
}

model ChildMilestone {
  id          String   @id @default(uuid())
  childId     String
  title       String   // "First steps", "Lost first tooth", "First day of school"
  category    String   // PHYSICAL, COGNITIVE, SOCIAL, ACADEMIC, HEALTH
  date        DateTime @default(now())
  notes       String?
  photo       String?  // optional image URL

  child       ChildProfile @relation(fields: [childId], references: [id])
}

model FamilyHabit {
  id            String   @id @default(uuid())
  familyGroupId String
  name          String   // "Brush teeth", "Take vitamins", "30 min exercise", "No screens after 9pm"
  icon          String?  // emoji
  frequency     String   @default("DAILY") // DAILY, WEEKDAYS, WEEKENDS, CUSTOM
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  assigns       FamilyHabitAssign[]
  logs          FamilyHabitLog[]
}

model FamilyHabitAssign {
  id          String   @id @default(uuid())
  habitId     String
  userId      String?  // adult member
  childId     String?  // child member

  habit       FamilyHabit   @relation(fields: [habitId], references: [id])
  child       ChildProfile? @relation(fields: [childId], references: [id])

  @@unique([habitId, userId])
}

model FamilyHabitLog {
  id          String   @id @default(uuid())
  habitId     String
  userId      String
  childId     String?  // if logging for a child
  completed   Boolean  @default(true)
  date        DateTime @default(now())

  habit       FamilyHabit @relation(fields: [habitId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
}

model FamilyGoal {
  id            String   @id @default(uuid())
  familyGroupId String
  title         String   // "No screens at dinner for 30 days"
  description   String?
  category      String   @default("GENERAL") // HEALTH, FITNESS, NUTRITION, SCREEN_TIME, RELATIONSHIP, EDUCATION, SAVINGS
  targetValue   Int?     // numeric target (e.g., 30 days)
  currentValue  Int      @default(0)
  unit          String?  // "days", "times", "km"
  deadline      DateTime?
  status        String   @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED, ABANDONED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CoupleGoal {
  id            String   @id @default(uuid())
  partnershipId String
  title         String
  category      String   @default("RELATIONSHIP") // RELATIONSHIP, HEALTH, FINANCE, TRAVEL, PARENTING
  deadline      DateTime?
  status        String   @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  partnerADone  Boolean  @default(false)
  partnerBDone  Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
}

model FamilyGratitude {
  id          String   @id @default(uuid())
  familyGroupId String
  fromUserId  String
  toUserId    String
  message     String
  date        DateTime @default(now())

  fromUser    User @relation("GratitudeFrom", fields: [fromUserId], references: [id])
  toUser      User @relation("GratitudeTo", fields: [toUserId], references: [id])
}
