# ============================================
# Nishma Wellness - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# All services below have FREE tiers

# ============================================
# DATABASE (Required)
# ============================================
# Local development (SQLite - works out of the box)
DATABASE_URL="file:./dev.db"
# Production (Neon PostgreSQL - free: 0.5GB)
# Sign up: https://neon.tech
# DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# ============================================
# AUTH (Required)
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secret-key-with-openssl-rand"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional - free unlimited)
# Sign up: https://console.cloud.google.com
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ============================================
# AI / LLM (For real AI responses)
# ============================================
# Anthropic Claude API (free $5 credit)
# Sign up: https://console.anthropic.com
# ANTHROPIC_API_KEY=""

# OpenAI (free $5 credit)
# Sign up: https://platform.openai.com
# OPENAI_API_KEY=""

# Used by the app (set to whichever you choose)
AI_API_KEY=""

# ============================================
# PAYMENTS (Stripe)
# ============================================
# Free test mode - unlimited transactions
# Sign up: https://stripe.com
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# EMAIL (Resend)
# ============================================
# Free: 100 emails/day, 3000/month
# Sign up: https://resend.com
# RESEND_API_KEY="re_..."

# ============================================
# VIDEO CALLS (Daily.co)
# ============================================
# Free: 10,000 minutes/month
# Sign up: https://daily.co
# DAILY_API_KEY=""
# DAILY_DOMAIN="your-domain.daily.co"

# ============================================
# AI VOICE / TTS (ElevenLabs)
# ============================================
# Free: 10,000 characters/month
# Sign up: https://elevenlabs.io
# ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID=""

# ============================================
# AI VIDEO AVATAR (D-ID)
# ============================================
# Free: 5 minutes trial
# Sign up: https://d-id.com
# DID_API_KEY=""

# ============================================
# FILE STORAGE (Cloudinary)
# ============================================
# Free: 25GB storage, 25GB bandwidth
# Sign up: https://cloudinary.com
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ============================================
# DEPLOYMENT
# ============================================
# Vercel (free: 100GB bandwidth)
# Sign up: https://vercel.com
# No env vars needed - configured in Vercel dashboard
